---
import Button from '@/components/Button.astro';
import PageHero from '@/components/PageHero.astro';
import PricesTables from '@/components/PricesTables.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import PublicLayout from '@/layouts/PublicLayout.astro';
import { euros } from '@/lib/catalog';
import { getRates, listActiveExtras, listActivePackages } from '@/lib/db';
import { fill, getDictionary } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n/config';
import { path } from '@/lib/i18n/routes';
import { TOUR_IDS, tourDestValue } from '@/lib/prices';
import { breadcrumbJsonLd, pageMetadata } from '@/lib/seo';
import { nightRule } from '@/lib/settings';
import { absoluteUrl, site, whatsappLink } from '@/lib/site';

/** Prices page — carried over from `project/Tarifs.dc.html`. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const rates = getRates();
const packages = listActivePackages();
const extras = listActiveExtras();
const night = nightRule();
const bookingHref = path(locale, 'booking');
const meta = pageMetadata({ locale, page: 'prices' });
const breadcrumb = breadcrumbJsonLd([
  { name: dict.nav.home, url: absoluteUrl(path(locale, 'home')) },
  { name: dict.prices.h1, url: absoluteUrl(path(locale, 'prices')) },
]);
---

<PublicLayout locale={locale} meta={meta} structuredData={[breadcrumb]}>
  <SiteHeader locale={locale} active="prices" />

  <main id="contenu">
    <PageHero title={dict.prices.h1} lead={dict.prices.lead} />

    <div class="mx-auto max-w-[1200px] px-6 py-14">
      <PricesTables dict={dict} rates={rates} bookingHref={bookingHref} />

      {
        night.enabled ? (
          <p class="mt-7 rounded-[14px] bg-sand px-5 py-4 text-[15px] font-bold text-ink-soft">
            🌙 {fill(dict.pricing.nightNote, { percent: night.percent, start: night.start, end: night.end })}
          </p>
        ) : null
      }
    </div>

    {/* ── Packages, created by the admin ────────────────── */}
    {
      packages.length > 0 ? (
        <section class="bg-sand">
          <div class="mx-auto max-w-[1200px] px-6 py-14">
            <h2 class="m-0 mb-2 font-display text-[30px]">{dict.pricing.packagesTitle}</h2>
            <p class="m-0 mb-7 max-w-[640px] text-base text-ink-soft">{dict.pricing.packagesLead}</p>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {packages.map((item) => (
                <a
                  href={`${bookingHref}?package=${encodeURIComponent(item.slug)}`}
                  class="flex flex-col gap-2 rounded-2xl border border-line bg-surface p-5 text-ink no-underline hover:border-brand hover:shadow-card"
                >
                  <div class="flex items-baseline justify-between gap-2.5">
                    <div class="text-base font-extrabold">{item.name}</div>
                    <div class="whitespace-nowrap font-display text-xl text-brand">{euros(item.priceCents)}</div>
                  </div>
                  {item.description ? <p class="m-0 text-sm leading-[1.6] text-ink-soft">{item.description}</p> : null}
                  <div class="text-[13px] font-bold text-ink-mute">{fill(dict.pricing.packageUpTo, { pax: item.maxPax })}</div>
                  <span class="mt-auto rounded-full bg-brand px-5 py-2.5 text-center text-sm font-extrabold text-surface">{dict.prices.bookThis}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : null
    }

    {/* ── Paid add-ons ─────────────────────────────── */}
    {
      extras.length > 0 ? (
        <div class="mx-auto max-w-[1200px] px-6 py-14">
          <h2 class="m-0 mb-2 font-display text-[30px]">{dict.pricing.extrasTitle}</h2>
          <p class="m-0 mb-7 max-w-[640px] text-base text-ink-soft">{dict.pricing.extrasLead}</p>

          <ul class="m-0 grid list-none gap-3 p-0 sm:grid-cols-2">
            {extras.map((item) => (
              <li class="flex items-baseline justify-between gap-4 rounded-xl border border-line bg-surface px-5 py-3.5">
                <span class="text-[15px] font-bold">{item.label}</span>
                <span class="whitespace-nowrap font-extrabold text-brand">
                  {euros(item.priceCents)}
                  {item.perUnit ? ` ${dict.pricing.extrasEach}` : ''}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ) : null
    }

    {/* ── Excursions, always on request ─────────────────────────── */}
    <section id="tours" class="border-y border-line bg-surface">
      <div class="mx-auto max-w-[1200px] px-6 py-14">
        <h2 class="m-0 mb-2 font-display text-[30px]">{dict.prices.toursTitle}</h2>
        <p class="m-0 mb-7 max-w-[640px] text-base text-ink-soft">{dict.prices.toursLead}</p>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            TOUR_IDS.map((id) => {
              const tour = dict.tours[id];
              return (
                <a
                  href={`${bookingHref}?to=${encodeURIComponent(tourDestValue(id))}`}
                  class="flex flex-col gap-2 rounded-2xl border border-line bg-cream p-5 text-ink no-underline hover:border-brand hover:shadow-card"
                >
                  <div class="flex items-baseline justify-between gap-2.5">
                    <div class="text-base font-extrabold">{tour.name}</div>
                    <div class="whitespace-nowrap rounded-full bg-sand px-2.5 py-[3px] text-xs font-extrabold text-brand">{tour.dur}</div>
                  </div>
                  <p class="m-0 text-sm leading-[1.6] text-ink-soft">{tour.desc}</p>
                  <span class="mt-auto rounded-full bg-brand px-5 py-2.5 text-center text-sm font-extrabold text-surface">{dict.prices.bookThis}</span>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    {/* ── Custom quote, reply within 2 h ───────────────────── */}
    <section class="mx-auto max-w-[900px] px-6 py-14">
      <div class="rounded-3xl bg-ink px-8 py-11 text-center">
        <div class="mb-3.5 inline-block rounded-full bg-gold px-4 py-1.5 text-[13px] font-extrabold text-ink">{dict.prices.customBadge}</div>
        <h2 class="m-0 mb-3 font-display text-[28px] text-surface">{dict.prices.customTitle}</h2>
        <p class="m-0 mb-6 text-base leading-[1.7] text-cream-soft">{dict.prices.customLead}</p>
        <div class="flex flex-wrap justify-center gap-3">
          <Button href={whatsappLink(dict.prices.customTitle)} variant="gold" class="px-7! py-3.5! text-base!">
            {dict.prices.customWhatsapp}
          </Button>
          <Button href={bookingHref} class="border-2! border-gold! bg-transparent! px-6! py-3! text-base! text-gold! hover:bg-ink-light!">
            {dict.prices.customForm}
          </Button>
          <Button href={site.phoneHref} variant="goldOutline" class="px-6! py-3! text-base!">📞 {site.phoneDisplay}</Button>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</PublicLayout>
