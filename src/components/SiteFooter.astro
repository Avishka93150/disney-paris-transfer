---
import { getDictionary } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n/config';
import { path, routePath } from '@/lib/i18n/routes';
import { ROUTE_PAGES } from '@/lib/prices';
import { site } from '@/lib/site';

/** Footer carried over from `project/SiteFooter.dc.html`. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);

const siteLinks = [
  { href: path(locale, 'prices'), label: dict.nav.prices },
  { href: path(locale, 'booking'), label: dict.footer.booking },
  { href: path(locale, 'about'), label: dict.nav.about },
  { href: path(locale, 'faq'), label: dict.nav.faq },
  { href: path(locale, 'contact'), label: dict.nav.contact },
];

const featured = ROUTE_PAGES.filter((route) => route.featured);
---

<footer class="bg-ink font-sans text-line">
  <div class="mx-auto grid max-w-[1200px] gap-10 px-6 pb-8 pt-14 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <div class="mb-2.5 font-display text-[22px] text-surface">
        {dict.common.brand} <span class="text-gold">{dict.common.brandAccent}</span>
      </div>
      <p class="m-0 text-sm leading-[1.7] text-cream-soft">{dict.footer.blurb}</p>
      <p class="mb-0 mt-3.5 text-[13px] text-ink-faint">{dict.footer.disclaimer}</p>
    </div>

    <div>
      <div class="mb-3.5 text-[13px] font-extrabold uppercase tracking-[1.2px] text-gold">{dict.footer.colRoutes}</div>
      <div class="flex flex-col gap-[9px] text-sm">
        {
          featured.map((route) => (
            <a href={routePath(locale, route.slug)} class="text-line no-underline hover:text-gold">
              {dict.zones[route.from]} ↔ {dict.zones[route.to]}
            </a>
          ))
        }
        <a href={path(locale, 'prices')} class="text-line no-underline hover:text-gold">{dict.prices.toursTitle}</a>
      </div>
    </div>

    <div>
      <div class="mb-3.5 text-[13px] font-extrabold uppercase tracking-[1.2px] text-gold">{dict.footer.colSite}</div>
      <div class="flex flex-col gap-[9px] text-sm">
        {siteLinks.map((link) => <a href={link.href} class="text-line no-underline hover:text-gold">{link.label}</a>)}
        <a href={path(locale, 'terms')} class="text-line no-underline hover:text-gold">{dict.footer.terms}</a>
        <a href={path(locale, 'privacy')} class="text-line no-underline hover:text-gold">{dict.footer.privacy}</a>
      </div>
    </div>

    <div>
      <div class="mb-3.5 text-[13px] font-extrabold uppercase tracking-[1.2px] text-gold">{dict.footer.colContact}</div>
      <div class="flex flex-col gap-[9px] text-sm">
        <a href={site.phoneHref} class="text-base font-extrabold text-surface no-underline hover:text-gold">{site.phoneDisplay}</a>
        <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="text-line no-underline hover:text-gold">
          {dict.footer.whatsappLine}
        </a>
        <a href={`mailto:${site.email}`} class="break-all text-line no-underline hover:text-gold">{site.email}</a>
        <span class="text-cream-soft">{dict.common.availability}</span>
      </div>
    </div>
  </div>

  <div class="border-t border-ink-light">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-3 px-6 py-4 text-xs text-ink-faint sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
      <span>{dict.footer.rights}</span>
      <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label={dict.footer.colLegal}>
        <a href={path(locale, 'terms')} class="text-ink-faint no-underline hover:text-gold">{dict.footer.terms}</a>
        <a href={path(locale, 'privacy')} class="text-ink-faint no-underline hover:text-gold">{dict.footer.privacy}</a>
        <a href={path(locale, 'cookies')} class="text-ink-faint no-underline hover:text-gold">{dict.footer.cookies}</a>
      </nav>
      <span>{dict.footer.seoLine}</span>
    </div>
  </div>
</footer>
