---
import { HERO_PHOTOS } from '@/lib/transfersMenu';

/**
 * Fading photo background for the home hero. The first frame is in the HTML
 * (eager, high priority: it is the page's largest element); the script in
 * `src/scripts/site.ts` cycles through the others and honours reduced-motion
 * by leaving the first frame still.
 */
---

<div class="absolute inset-0 overflow-hidden" aria-hidden="true" data-hero-slideshow>
  {
    HERO_PHOTOS.map((src, index) => (
      <img
        src={src}
        alt=""
        width="1600"
        height="900"
        loading={index === 0 ? 'eager' : 'lazy'}
        fetchpriority={index === 0 ? 'high' : 'low'}
        decoding="async"
        data-hero-slide
        class:list={[
          'absolute inset-0 h-full w-full object-cover transition-opacity duration-1000',
          index === 0 ? 'opacity-100' : 'opacity-0',
        ]}
      />
    ))
  }
  <div class="absolute inset-0 bg-ink/25"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-ink/55 via-ink/25 to-ink/10"></div>
  <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-cream to-transparent"></div>
</div>
