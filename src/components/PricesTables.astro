---
import DestinationIcon from '@/components/DestinationIcon.astro';
import RateTable from '@/components/RateTable.astro';
import type { Dictionary } from '@/lib/i18n/types';
import { TOUR_IDS, ZONE_IDS, ZONE_KIND_ORDER, collapseTiers, tourDestValue, zonesOfKind, type ZoneId } from '@/lib/prices';

/**
 * Rate tables filtered by departure point — from `project/Tarifs.dc.html`.
 *
 * Every departure's tables are in the HTML (good for search engines: every
 * price on the grid is indexable), one panel per departure; the filter pills
 * only show and hide them (`src/scripts/prices-tables.ts`).
 */
interface Props {
  dict: Dictionary;
  rates: Record<string, readonly number[]>;
  bookingHref: string;
}

const { dict, rates, bookingHref } = Astro.props;
const DEFAULT: ZoneId = 'cdg';

function bookUrl(from: string, to: string, extra: Record<string, string | number> = {}) {
  const params = new URLSearchParams({ from, to });
  for (const [key, value] of Object.entries(extra)) params.set(key, String(value));
  return `${bookingHref}?${params.toString()}`;
}

function tablesFor(zone: ZoneId) {
  const result: { key: string; title: string; min: number; other: string; rows: ReturnType<typeof collapseTiers> }[] = [];
  for (const [pair, rate] of Object.entries(rates)) {
    const [a, b] = pair.split('-');
    const other = a === zone ? b : b === zone ? a : null;
    if (!other || !(ZONE_IDS as readonly string[]).includes(other)) continue;
    result.push({
      key: pair,
      title: `${dict.zones[zone]} ↔ ${dict.zones[other as ZoneId]}`,
      min: Math.min(...rate),
      other,
      rows: collapseTiers(rate),
    });
  }
  return result.sort((x, y) => x.min - y.min);
}

const pill = (active: boolean) =>
  `cursor-pointer rounded-full border px-[18px] py-[9px] font-sans text-sm font-extrabold hover:border-brand ${
    active ? 'border-brand bg-brand text-surface' : 'border-line bg-surface text-ink'
  }`;
---

<div data-prices-tables>
  <div class="mb-7 flex flex-col gap-5">
    <span class="text-[15px] font-extrabold">{dict.prices.departLabel}</span>
    {
      ZONE_KIND_ORDER.map((kind) => (
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-2 text-[13px] font-extrabold text-ink-soft">
            <span class="text-brand">
              <DestinationIcon kind={kind} />
            </span>
            {dict.destinationKinds[kind]}
          </div>
          <div class="flex flex-wrap items-center gap-3">
            {zonesOfKind(kind).map((id) => (
              <button type="button" aria-pressed={id === DEFAULT ? 'true' : 'false'} data-prices-filter={id} class={pill(id === DEFAULT)}>
                {dict.zones[id]}
              </button>
            ))}
          </div>
        </div>
      ))
    }
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2 text-[13px] font-extrabold text-ink-soft">
        <span class="text-brand"><DestinationIcon kind="tours" /></span>
        {dict.destinationKinds.tours}
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" aria-pressed="false" data-prices-filter="tours" class={pill(false)}>
          {dict.destinationKinds.tours}
        </button>
      </div>
    </div>
  </div>

  {
    ZONE_IDS.map((zone) => {
      const tables = tablesFor(zone);
      return (
        <div data-prices-panel={zone} hidden={zone !== DEFAULT}>
          {tables.length === 0 ? (
            <p class="rounded-[18px] border border-line bg-surface p-6 text-[15px] text-ink-soft">{dict.prices.noRoute}</p>
          ) : (
            <div class="grid gap-5 lg:grid-cols-2">
              {tables.map((table) => (
                <div class="flex flex-col gap-3.5 rounded-[18px] border border-line bg-surface p-6">
                  <a href={bookUrl(zone, table.other)} class="flex flex-wrap items-baseline justify-between gap-2.5 text-ink no-underline hover:text-brand">
                    <div class="font-display text-[19px]">{table.title}</div>
                    <div class="text-[13px] font-bold text-ink-mute">
                      {dict.common.from} <span class="text-base text-brand">{table.min} €</span>
                    </div>
                  </a>

                  <RateTable
                    dict={dict}
                    rows={table.rows}
                    caption={table.title}
                    hrefFor={(row, trip) => bookUrl(zone, table.other, { pax: row.pax, trip })}
                  />

                  <a
                    href={bookUrl(zone, table.other)}
                    class="rounded-full bg-brand py-[11px] text-center text-sm font-extrabold text-surface no-underline hover:bg-brand-dark"
                  >
                    {dict.prices.bookThis}
                  </a>
                </div>
              ))}
            </div>
          )}
        </div>
      );
    })
  }

  <div data-prices-panel="tours" hidden>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        TOUR_IDS.map((id) => {
          const tour = dict.tours[id];
          return (
            <a
              href={bookUrl('paris', tourDestValue(id))}
              class="flex flex-col gap-2 rounded-2xl border border-line bg-cream p-5 text-ink no-underline hover:border-brand hover:shadow-card"
            >
              <div class="flex items-baseline justify-between gap-2.5">
                <div class="text-base font-extrabold">{tour.name}</div>
                <div class="whitespace-nowrap rounded-full bg-sand px-2.5 py-[3px] text-xs font-extrabold text-brand">{tour.dur}</div>
              </div>
              <p class="m-0 text-sm leading-[1.6] text-ink-soft">{tour.desc}</p>
              <span class="mt-auto text-[13px] font-extrabold text-brand">{dict.prices.tourCta}</span>
            </a>
          );
        })
      }
    </div>
  </div>
</div>

<script>
  import '@/scripts/prices-tables';
</script>
