---
import Feedback from '@/components/admin/Feedback.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { changePasswordAction, saveSettingsAction, saveSmtpAction } from '@/lib/admin/actions';
import { feedbackFor, handlePost, submitted, submittedChecked } from '@/lib/admin/page';
import { getSession, MIN_PASSWORD_LENGTH } from '@/lib/auth';
import { getSettings, secretHint, smtpFormValues, stripeConfigured, stripeSecretKey, stripeWebhookSecret } from '@/lib/settings';
import { site } from '@/lib/site';

if (!getSession(Astro.cookies)) return Astro.redirect('/admin/login');

const { redirect, feedback } = await handlePost(Astro, (form) => {
  switch (form.get('action')) {
    case 'settings':
      return { key: 'settings', state: saveSettingsAction(form) };
    case 'smtp':
      return { key: 'smtp', state: saveSmtpAction(form) };
    case 'password':
      return { key: 'password', state: changePasswordAction(form) };
    default:
      return null;
  }
});
if (redirect) return redirect;

const settings = getSettings();
const configured = stripeConfigured();
const smtp = smtpFormValues();
const stripeHint = secretHint(stripeSecretKey());
const webhookSet = Boolean(stripeWebhookSecret());
const adminEmail = process.env.ADMIN_EMAIL ?? '';

const s = {
  night: submittedChecked(feedback, 'settings', 'nightSurchargeEnabled') ?? settings.nightSurchargeEnabled,
  nightStart: submitted(feedback, 'settings', 'nightStart') ?? settings.nightStart,
  nightEnd: submitted(feedback, 'settings', 'nightEnd') ?? settings.nightEnd,
  nightPercent: submitted(feedback, 'settings', 'nightSurchargePercent') ?? String(settings.nightSurchargePercent),
  stripeEnabled: submittedChecked(feedback, 'settings', 'stripeEnabled') ?? settings.stripeEnabled,
  stripeMode: submitted(feedback, 'settings', 'stripeMode') ?? settings.stripeMode,
  depositPercent: submitted(feedback, 'settings', 'depositPercent') ?? String(settings.depositPercent),
};

const m = {
  host: submitted(feedback, 'smtp', 'smtpHost') ?? smtp.host,
  port: submitted(feedback, 'smtp', 'smtpPort') ?? String(smtp.port),
  secure: submittedChecked(feedback, 'smtp', 'smtpSecure') ?? smtp.secure,
  user: submitted(feedback, 'smtp', 'smtpUser') ?? smtp.user,
  mailFrom: submitted(feedback, 'smtp', 'mailFrom') ?? smtp.mailFrom,
  mailTo: submitted(feedback, 'smtp', 'mailTo') ?? smtp.mailTo,
};

const wraps = s.nightEnd <= s.nightStart;
const example = Math.round(80 * (1 + (Number(s.nightPercent) || 0) / 100));

const publicDetails = [
  ['Phone', site.phoneDisplay, 'SITE_PHONE_DISPLAY'],
  ['WhatsApp', site.whatsapp, 'SITE_WHATSAPP'],
  ['Email', site.email, 'SITE_EMAIL'],
  ['Site address', site.url, 'APP_URL'],
];

const submitClass =
  'w-fit cursor-pointer rounded-full border-none bg-brand px-6 py-3 font-sans text-[15px] font-extrabold text-surface hover:bg-brand-dark disabled:opacity-60';
---

<AdminLayout title="Settings" signedIn>
  <main class="mx-auto max-w-[800px] px-6 py-10">
    <h1 class="m-0 mb-2 font-display text-[28px]">Settings</h1>
    <p class="m-0 mb-8 text-[15px] leading-[1.7] text-ink-soft">
      Night hours, online payment, mailbox and the admin password. Secrets pasted here override the <code>.env</code> file without a
      restart.
    </p>

    <div class="flex flex-col gap-8">
      <form method="post" class="flex flex-col gap-8" data-settings-form>
        <input type="hidden" name="action" value="settings" />

        <section class="flex flex-col gap-5 rounded-2xl border border-line bg-surface p-6">
          <div>
            <label class="flex cursor-pointer items-start gap-3">
              <input type="checkbox" name="nightSurchargeEnabled" checked={s.night} data-night-toggle class="mt-1 h-5 w-5 accent-[#B4552D]" />
              <span>
                <span class="block text-base font-extrabold">Night supplement</span>
                <span class="block text-sm leading-[1.6] text-ink-soft">
                  Adds a percentage to every fare, package and route whose pickup time falls inside the night hours below. Add-ons are never
                  surcharged.
                </span>
              </span>
            </label>
          </div>

          <fieldset disabled={!s.night} data-night-fields class="m-0 flex flex-col gap-4 border-0 p-0 disabled:opacity-50">
            <div class="grid gap-4 sm:grid-cols-3">
              <label class="field-label">
                Night starts at
                <input type="time" name="nightStart" value={s.nightStart} class="field" />
              </label>

              <label class="field-label">
                Night ends at
                <input type="time" name="nightEnd" value={s.nightEnd} class="field" />
              </label>

              <label class="field-label">
                Supplement (%)
                <input type="number" name="nightSurchargePercent" min="1" max="200" step="1" value={s.nightPercent} class="field" />
              </label>
            </div>

            <p class="m-0 rounded-[10px] bg-sand p-3 text-[13px] leading-[1.6] text-ink-soft" data-night-summary>
              {
                wraps ? (
                  <>
                    Pickups from <strong>{s.nightStart || '—'}</strong> in the evening through to <strong>{s.nightEnd || '—'}</strong> the
                    next morning are charged <strong>+{Number(s.nightPercent) || 0} %</strong>.
                  </>
                ) : (
                  <>
                    Pickups between <strong>{s.nightStart || '—'}</strong> and <strong>{s.nightEnd || '—'}</strong> on the same day are charged{' '}
                    <strong>+{Number(s.nightPercent) || 0} %</strong>.
                  </>
                )
              }{' '}
              An €80 transfer becomes <strong>{example} €</strong>. On a round trip the supplement applies to both legs, based on the outbound
              pickup time.
            </p>
          </fieldset>
        </section>

        <section class="flex flex-col gap-5 rounded-2xl border border-line bg-surface p-6">
          <div>
            <h2 class="m-0 mb-1 font-display text-xl">Stripe</h2>
            <p class="m-0 mb-4 text-sm leading-[1.6] text-ink-soft">
              Keys can be pasted here or left in the <code>.env</code> file. Values saved in admin override the environment. Leave a field
              blank to keep the current secret.
            </p>

            <div class="mb-5 grid gap-4 sm:grid-cols-2">
              <label class="field-label">
                Secret key
                <input
                  type="password"
                  name="stripeSecretKey"
                  autocomplete="off"
                  placeholder={stripeHint ?? 'sk_live_…'}
                  data-stripe-key
                  class="field font-mono"
                />
                <span class="text-[12px] font-bold text-ink-mute">{stripeHint ? `Saved ${stripeHint}` : 'Not set yet'}</span>
              </label>

              <label class="field-label">
                Webhook secret
                <input type="password" name="stripeWebhookSecret" autocomplete="off" placeholder={webhookSet ? 'whsec_… (saved)' : 'whsec_…'} class="field font-mono" />
                <span class="text-[12px] font-bold text-ink-mute">
                  {webhookSet ? 'Saved — leave blank to keep it' : 'Needed to mark bookings as paid'}
                </span>
              </label>
            </div>

            <label class="flex cursor-pointer items-start gap-3">
              <input
                type="checkbox"
                name="stripeEnabled"
                checked={s.stripeEnabled}
                disabled={!configured}
                data-stripe-toggle
                data-stripe-configured={configured ? '1' : '0'}
                class="mt-1 h-5 w-5 accent-[#B4552D]"
              />
              <span>
                <span class="block text-base font-extrabold">Enable online payment</span>
                <span class="block text-sm leading-[1.6] text-ink-soft">
                  While this box is unticked, no payment button appears anywhere on the site: customers pay on board, as they do today. You can
                  tick it in the same save as a newly pasted key.
                </span>
              </span>
            </label>

            {
              !configured ? (
                <p class="mb-0 mt-3 rounded-[10px] bg-sand p-3 text-[13px] leading-[1.6] text-ink-soft">
                  Paste a secret key above (or set <code>STRIPE_SECRET_KEY</code> in <code>.env</code>) before the payment button can be
                  switched on.
                </p>
              ) : null
            }
          </div>

          <fieldset disabled={!s.stripeEnabled} data-stripe-fields class="m-0 flex flex-col gap-4 border-0 p-0 disabled:opacity-50">
            <legend class="mb-2 text-base font-extrabold">Amount collected</legend>

            <label class="flex cursor-pointer items-center gap-3 text-[15px]">
              <input type="radio" name="stripeMode" value="full" checked={s.stripeMode === 'full'} data-stripe-mode class="h-4 w-4 accent-[#B4552D]" />
              Full payment for the transfer
            </label>

            <label class="flex cursor-pointer items-center gap-3 text-[15px]">
              <input type="radio" name="stripeMode" value="deposit" checked={s.stripeMode === 'deposit'} data-stripe-mode class="h-4 w-4 accent-[#B4552D]" />
              Deposit, balance paid on board
            </label>

            <label class="field-label max-w-[220px]">
              Deposit percentage
              <input
                type="number"
                name="depositPercent"
                min="5"
                max="100"
                step="1"
                value={s.depositPercent}
                disabled={s.stripeMode !== 'deposit'}
                data-deposit-percent
                class="field"
              />
            </label>
          </fieldset>
        </section>

        <div class="flex flex-col gap-3">
          <button type="submit" class={submitClass}>Save settings</button>
          <Feedback state={feedbackFor(feedback, 'settings')} />
        </div>
      </form>

      <form method="post" class="flex flex-col gap-5 rounded-2xl border border-line bg-surface p-6">
        <input type="hidden" name="action" value="smtp" />
        <div>
          <h2 class="m-0 mb-1 font-display text-xl">Email (SMTP)</h2>
          <p class="m-0 text-sm leading-[1.6] text-ink-soft">
            Booking notifications go through this mailbox. Leave the host empty to keep logging emails to the server console. A blank
            password field keeps the current secret.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field-label sm:col-span-2">
            SMTP host
            <input name="smtpHost" value={m.host} placeholder="ssl0.ovh.net" class="field font-mono" />
          </label>

          <label class="field-label">
            Port
            <input name="smtpPort" value={m.port} inputmode="numeric" class="field font-mono" />
          </label>

          <label class="flex cursor-pointer items-center gap-3 pt-6 text-[15px] font-bold">
            <input type="checkbox" name="smtpSecure" checked={m.secure} class="h-5 w-5 accent-[#B4552D]" />
            TLS / SSL (usually on for port 465)
          </label>

          <label class="field-label">
            Username
            <input name="smtpUser" value={m.user} autocomplete="off" class="field" />
          </label>

          <label class="field-label">
            Password
            <input type="password" name="smtpPass" autocomplete="new-password" placeholder={smtp.passSet ? '•••••••• (saved)' : ''} class="field" />
          </label>

          <label class="field-label sm:col-span-2">
            From
            <input name="mailFrom" value={m.mailFrom} placeholder="Disney Paris Transfers <contact@example.com>" class="field" />
          </label>

          <label class="field-label sm:col-span-2">
            Booking emails delivered to
            <input name="mailTo" value={m.mailTo} placeholder="contact@example.com" class="field" />
          </label>
        </div>

        <button type="submit" class={submitClass}>Save mail settings</button>
        <Feedback state={feedbackFor(feedback, 'smtp')} />
      </form>

      <form method="post" class="flex flex-col gap-5 rounded-2xl border border-line bg-surface p-6">
        <input type="hidden" name="action" value="password" />
        <div>
          <h2 class="m-0 mb-1 font-display text-xl">Admin password</h2>
          <p class="m-0 text-sm leading-[1.6] text-ink-soft">
            Sign-in stays <strong>{adminEmail || 'the ADMIN_EMAIL in .env'}</strong>. A password saved here overrides{' '}
            <code>ADMIN_PASSWORD_HASH</code> without editing the server files.
          </p>
        </div>

        <label class="field-label">
          Current password
          <input type="password" name="currentPassword" autocomplete="current-password" required class="field" />
        </label>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field-label">
            New password
            <input type="password" name="newPassword" autocomplete="new-password" minlength={MIN_PASSWORD_LENGTH} required class="field" />
          </label>

          <label class="field-label">
            Confirm new password
            <input type="password" name="confirmPassword" autocomplete="new-password" minlength={MIN_PASSWORD_LENGTH} required class="field" />
          </label>
        </div>

        <p class="m-0 text-[13px] font-bold text-ink-mute">At least {MIN_PASSWORD_LENGTH} characters.</p>

        <button type="submit" class={submitClass}>Change password</button>
        <Feedback state={feedbackFor(feedback, 'password')} />
      </form>
    </div>

    <section class="mt-8 rounded-2xl border border-line bg-surface p-6">
      <h2 class="m-0 mb-4 font-display text-xl">Public contact details</h2>
      <p class="m-0 mb-4 text-sm leading-[1.6] text-ink-soft">
        These come from the <code>.env</code> file and appear on every page, in all 9 languages. Change them there, then restart the site.
      </p>
      <table class="w-full border-collapse text-sm">
        <tbody>
          {
            publicDetails.map(([label, value, variable]) => (
              <tr class="border-b border-line-strong last:border-0">
                <td class="py-2 pr-4 text-ink-soft">{label}</td>
                <td class="py-2 font-bold">{value}</td>
                <td class="py-2 text-right font-mono text-[12px] text-ink-mute">{variable}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </main>

  <script>
    import '@/scripts/admin';
  </script>
</AdminLayout>
