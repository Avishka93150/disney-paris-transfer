---
import Feedback from '@/components/admin/Feedback.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { updateBookingAction } from '@/lib/admin/actions';
import { feedbackFor, handlePost, submitted } from '@/lib/admin/page';
import { getSession } from '@/lib/auth';
import { bookingExtras, getBookingById } from '@/lib/booking';
import { euros } from '@/lib/catalog';
import { destinationLabel } from '@/lib/i18n';
import { en } from '@/lib/i18n/dictionaries/en';
import type { VehicleId } from '@/lib/prices';
import { whatsappLink } from '@/lib/site';

if (!getSession(Astro.cookies)) return Astro.redirect('/admin/login');

const id = Number(Astro.params.id);
if (!Number.isInteger(id)) return new Response(null, { status: 404 });

const { redirect, feedback } = await handlePost(Astro, (form) => ({ key: 'booking', state: updateBookingAction(form) }));
if (redirect) return redirect;

const booking = getBookingById(id);
if (!booking) return new Response(null, { status: 404 });

const option = (list: string[], index: string | null): string => {
  if (index === null) return '—';
  return list[Number.parseInt(index, 10)] ?? index;
};
const zone = (value: string) => destinationLabel(en, value);

// Old bookings can carry a vehicle id that no longer exists in the app.
const vehicleEntry = booking.vehicle ? en.vehicles[booking.vehicle as VehicleId] : undefined;
const vehicle =
  booking.vehicle && booking.vehicle !== 'advise' ? (vehicleEntry?.label ?? booking.vehicle) : 'To be advised';

const extras = bookingExtras(booking);

const details: [string, string][] = [
  ...(booking.package_name ? ([['Package', booking.package_name]] as [string, string][]) : []),
  ['From', zone(booking.from_zone)],
  ['To', zone(booking.to_zone)],
  ['Trip', booking.trip === 'rt' ? 'Round trip' : 'One way'],
  ['Date', booking.travel_date ?? '—'],
  ['Time', booking.travel_time ?? '—'],
  ['Passengers', String(booking.pax)],
  ['Luggage', option(en.booking.bagOptions, booking.bags)],
  ['Vehicle', vehicle],
  ['Child seats', option(en.booking.seatOptions, booking.child_seats)],
  ['Flight no.', booking.flight ?? '—'],
  ['Customer language', booking.locale.toUpperCase()],
  ['Payment', booking.payment_status === 'paid' ? `Paid — ${Math.round((booking.paid_amount_cents ?? 0) / 100)} €` : booking.payment_status],
];

// Only worth showing once there is something to break down.
const showBreakdown =
  booking.base_price_cents != null && (booking.night_surcharge_cents || booking.extras_price_cents || extras.length > 0);

const waMessage = `Hello ${booking.customer_name}, about your request ${booking.reference} (${zone(booking.from_zone)} → ${zone(booking.to_zone)}):`;

const priceEuros = booking.quoted_price_cents == null ? '' : String(Math.round(booking.quoted_price_cents / 100));
const form = {
  status: submitted(feedback, 'booking', 'status') ?? booking.status,
  price: submitted(feedback, 'booking', 'price') ?? priceEuros,
  notes: submitted(feedback, 'booking', 'notes') ?? (booking.admin_notes ?? ''),
};
---

<AdminLayout title={booking.reference} signedIn>
  <main class="mx-auto max-w-[1100px] px-6 py-10">
    <a href="/admin" class="text-sm font-bold text-brand no-underline">← All bookings</a>

    <h1 class="mb-1 mt-4 font-display text-[28px]">
      <span class="font-mono">{booking.reference}</span> — {booking.customer_name}
    </h1>
    <p class="m-0 mb-8 text-sm text-ink-mute">Received {new Date(booking.created_at).toLocaleString('en-GB')}</p>

    <div class="grid gap-6 lg:grid-cols-[1.3fr_1fr]">
      <div class="flex flex-col gap-6">
        <div class="rounded-2xl border border-line bg-surface p-6">
          <h2 class="m-0 mb-4 font-display text-xl">Trip details</h2>
          <table class="w-full border-collapse text-sm">
            <tbody>
              {
                details.map(([label, value]) => (
                  <tr class="border-b border-line-strong last:border-0">
                    <td class="py-2 pr-4 text-ink-soft">{label}</td>
                    <td class="py-2 font-bold">{value}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          {booking.message ? <div class="mt-4 whitespace-pre-wrap rounded-xl bg-sand p-4 text-sm leading-[1.6]">{booking.message}</div> : null}
        </div>

        {
          showBreakdown ? (
            <div class="rounded-2xl border border-line bg-surface p-6">
              <h2 class="m-0 mb-4 font-display text-xl">How this price was calculated</h2>
              <table class="w-full border-collapse text-sm">
                <tbody>
                  <tr class="border-b border-line-strong">
                    <td class="py-2 pr-4 text-ink-soft">{booking.package_name ? 'Package' : 'Fare'}</td>
                    <td class="py-2 text-right font-bold">{euros(booking.base_price_cents ?? 0)}</td>
                  </tr>

                  {booking.night_surcharge_cents ? (
                    <tr class="border-b border-line-strong">
                      <td class="py-2 pr-4 text-ink-soft">Night supplement</td>
                      <td class="py-2 text-right font-bold">+ {euros(booking.night_surcharge_cents)}</td>
                    </tr>
                  ) : null}

                  {extras.map((extra) => (
                    <tr class="border-b border-line-strong">
                      <td class="py-2 pr-4 text-ink-soft">
                        {extra.label}
                        {extra.qty > 1 ? ` × ${extra.qty}` : ''}
                      </td>
                      <td class="py-2 text-right font-bold">+ {euros(extra.totalCents)}</td>
                    </tr>
                  ))}

                  <tr>
                    <td class="py-2 pr-4 font-extrabold">Total quoted</td>
                    <td class="py-2 text-right font-extrabold text-brand">{euros(booking.quoted_price_cents ?? 0)}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          ) : null
        }

        <div class="rounded-2xl border border-line bg-surface p-6">
          <h2 class="m-0 mb-4 font-display text-xl">Contact</h2>
          <div class="flex flex-col gap-2 text-sm">
            <a href={`mailto:${booking.customer_email}`} class="font-bold text-brand">{booking.customer_email}</a>
            <a href={`tel:${booking.customer_phone}`} class="font-bold text-brand">{booking.customer_phone}</a>
            <a
              href={whatsappLink(waMessage)}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 inline-block w-fit rounded-full bg-whatsapp px-4 py-2 font-extrabold text-ink no-underline hover:bg-whatsapp-dark"
            >
              💬 Reply on WhatsApp
            </a>
          </div>
        </div>
      </div>

      <form method="post" class="flex flex-col gap-4 rounded-2xl border border-line bg-surface p-6">
        <input type="hidden" name="id" value={booking.id} />

        <label class="field-label">
          Status
          <select name="status" class="field">
            {
              (['new', 'quoted', 'confirmed', 'cancelled'] as const).map((value) => (
                <option value={value} selected={form.status === value}>
                  {value.charAt(0).toUpperCase() + value.slice(1)}
                </option>
              ))
            }
          </select>
        </label>

        <label class="field-label">
          Confirmed price (€)
          <input type="text" inputmode="decimal" name="price" value={form.price} placeholder="leave empty for “on request”" class="field" />
        </label>

        <label class="field-label">
          Internal notes
          <textarea name="notes" rows="4" class="field resize-y">{form.notes}</textarea>
        </label>

        <button
          type="submit"
          class="cursor-pointer rounded-full border-none bg-brand px-6 py-3 font-sans text-[15px] font-extrabold text-surface hover:bg-brand-dark disabled:opacity-60"
        >
          Save
        </button>

        <Feedback state={feedbackFor(feedback, 'booking')} />
      </form>
    </div>
  </main>
</AdminLayout>
