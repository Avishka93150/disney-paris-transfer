---
/**
 * Shell of every public page: the complete `<head>` a search engine expects
 * (title, description, canonical, `hreflang` for the 9 languages, Open Graph,
 * Twitter card, JSON-LD), then the skip link, the page and the cookie notice.
 *
 * No client framework is loaded: the only JavaScript on a public page is the
 * small script in `src/scripts/site.ts` (menus, language picker, cookie
 * banner, hero slideshow) plus, where present, the calculator or the form.
 */
import '@/styles/globals.css';
import CookieBanner from '@/components/CookieBanner.astro';
import { getDictionary } from '@/lib/i18n';
import { LOCALE_META, type Locale } from '@/lib/i18n/config';
import { jsonLd, type PageMeta } from '@/lib/seo';
import { site } from '@/lib/site';

interface Props {
  locale: Locale;
  meta: PageMeta;
  /** Structured data blocks, one `<script type="application/ld+json">` each. */
  structuredData?: Record<string, unknown>[];
}

const { locale, meta, structuredData = [] } = Astro.props;
const dict = getDictionary(locale);
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={meta.robots} />
    <link rel="canonical" href={meta.canonical} />
    {meta.alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:image" content={meta.ogImage} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:alt" content={meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage} />

    <link rel="preload" href="/fonts/bree-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nunito-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#FBF6ED" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    {structuredData.map((data) => <script is:inline type="application/ld+json" set:html={jsonLd(data)} />)}
  </head>
  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200] focus:rounded-full focus:bg-brand focus:px-5 focus:py-3 focus:font-bold focus:text-surface"
    >
      {dict.common.skipToContent}
    </a>
    <slot />
    <CookieBanner locale={locale} dict={dict} />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
