# ─── General ─────────────────────────────────────────────────────
APP_URL=https://disneyparistransfers.com

# Signing key for the admin session cookie — 32 characters minimum.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Admin ──────────────────────────────────────────────────────
ADMIN_EMAIL=contact@disneyparistransfers.com
# Generate with: npm run admin:hash -- 'your-password'
# Format: scrypt:<salt>:<hash> — paste the line as-is, without quotes.
# After first login the password can also be changed from Admin → Settings.
ADMIN_PASSWORD_HASH=

# ─── SMTP (a classic host: OVH, Gandi, Ionos…) ───────────────────────────
# Leave SMTP_HOST empty in development: emails are then printed to the console
# instead of being sent, and the rest of the site works normally.
# These can also be filled in later from Admin → Settings (they then override .env).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Disney Paris Transfers <contact@disneyparistransfers.com>"
MAIL_TO=contact@disneyparistransfers.com

# ─── Stripe (optional) ─────────────────────────────────────────────
# Online payment is switched on and off from the admin.
# Keys can be pasted there too; without a key the switch stays greyed out.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Contact (shown publicly) ──────────────────────────────────────
# Read at request time: change them, restart, no rebuild needed.
# (The old NEXT_PUBLIC_* names are still accepted as a fallback.)
SITE_PHONE=+33781662122
SITE_PHONE_DISPLAY=07 81 66 21 22
SITE_WHATSAPP=33781662122
SITE_EMAIL=contact@disneyparistransfers.com

# ─── Server ──────────────────────────────────────────────────────
# Port and interface the production server listens on (`npm start`).
# PORT=3000
# HOST=0.0.0.0

# ─── Deployment (`npm run deploy`, from your own computer) ──────────────
# Method 1 — straight to the Plesk server over SSH (nothing goes through GitHub).
# The user is the domain's system user, with "Access over SSH: /bin/bash" in Plesk.
# DEPLOY_SSH=disneyparistransfers@disneyparistransfers.com
# DEPLOY_PATH=/var/www/vhosts/disneyparistransfers.com/httpdocs
# Method 2 — when DEPLOY_SSH is empty: push the built site to the `deploy` branch
# on GitHub, then ping Plesk so it pulls at once (URL shown in Websites & Domains → Git).
# PLESK_WEBHOOK_URL=

# ─── Storage ─────────────────────────────────────────────────
# Where the SQLite file lives. Defaults to ./data/app.db.
# DATABASE_PATH=/var/lib/disneyparistransfers/app.db
