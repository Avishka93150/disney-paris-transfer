# ─── General ─────────────────────────────────────────────────────
APP_URL=https://disneyparistransfers.com

# Signing key for the admin session cookie — 32 characters minimum.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Admin ──────────────────────────────────────────────────────
ADMIN_EMAIL=contact@disneyparistransfers.com
# Generate with: npm run admin:hash -- 'your-password'
# Format: scrypt:<salt>:<hash> — paste the line as-is, without quotes.
ADMIN_PASSWORD_HASH=

# ─── SMTP (a classic host: OVH, Gandi, Ionos…) ───────────────────────────
# Leave SMTP_HOST empty in development: emails are then printed to the console
# instead of being sent, and the rest of the site works normally.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Disney Paris Transfers <contact@disneyparistransfers.com>"
MAIL_TO=contact@disneyparistransfers.com

# ─── Stripe (optional) ─────────────────────────────────────────────
# Online payment is switched on and off from the admin.
# Without these keys the switch stays greyed out.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Contact (shown publicly) ──────────────────────────────────────
NEXT_PUBLIC_PHONE=+33781662122
NEXT_PUBLIC_PHONE_DISPLAY=07 81 66 21 22
NEXT_PUBLIC_WHATSAPP=33781662122
NEXT_PUBLIC_EMAIL=contact@disneyparistransfers.com

# ─── Storage ─────────────────────────────────────────────────
# Where the SQLite file lives. Defaults to ./data/app.db.
# DATABASE_PATH=/var/lib/disneyparistransfers/app.db
